# Configuração para Hostinger (Apache / LiteSpeed). Envie junto com o resto do site.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Redirecionar http -> https: tire o "#" das 4 linhas abaixo DEPOIS de ativar o SSL no hPanel.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/ld+json text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  # CSS e JS levam um código do conteúdo no nome (ex.: case.1ecc2bb451.css): cada versão é um arquivo novo,
  # então podem ficar em cache por 1 ano sem risco de misturar versões.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # As páginas HTML são sempre conferidas com o servidor, para a versão nova aparecer logo depois do upload.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.[0-9a-f]{10}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
